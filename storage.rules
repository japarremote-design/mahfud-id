rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Lampiran KTP aspirasi: siapa saja boleh UPLOAD (warga isi form),
    // tapi HANYA email admin di daftar ini yang boleh BACA/lihat filenya.
    // PENTING: kalau nambah admin baru, tambahkan emailnya di sini juga
    // (bukan cuma di ADMIN_EMAILS / node /admins di Realtime Database),
    // lalu redeploy: firebase deploy --only storage
    match /aspirasi-ktp/{fileName} {
      allow write: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null &&
                    request.auth.token.email == 'qfazdigital@gmail.com';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
